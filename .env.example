# --- Meta Graph API Settings ---
FACEBOOK_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_GRAPH_API_VERSION=v26.0

# --- MCP Authentication & Transport ---
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=your_mcp_bearer_auth_token_here
MCP_TRANSPORT=stdio # Use 'http' for production deployment behind Coolify / Traefik
HOST=0.0.0.0
PORT=8000

# --- Financial Safeguards ---
# Daily budget ceiling in account currency (default R$10.00)
MAX_CAMPAIGN_BUDGET=10.00

# --- Cloudinary Asset Management (Scope C) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Crawler & HTTP Limits ---
CRAWLER_CONCURRENCY=1
CRAWLER_TIMEOUT=45
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
